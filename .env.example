# Frontend build config. Copy to .env.local for dev; set these in your build
# environment (and your mobile build) for release.
#
# There is no Gemini key here. The key lives only in server/.env — see
# server/README.md. Anything named VITE_* is compiled into the bundle and is
# public by definition, so never put a secret in this file.

# Where the AI backend lives.
#   Web dev:  leave blank — vite proxies /api to http://localhost:8787
#   Mobile:   REQUIRED. The packaged app has no proxy, and a blank value makes
#             it request https://localhost/api/... (its own bundled assets)
#             and 404. Point it at your deployed server.
# VITE_API_BASE_URL=https://api.kairosphere.app

# Where the live phenomena feed is published.
#   Web dev:  leave blank — the bundled public/data/phenomena.json is used
#   Mobile:   STRONGLY RECOMMENDED. Without it the app ships a feed frozen at
#             build time that only decays. With it the app refreshes over the
#             network and keeps the bundled copy as an offline fallback.
# VITE_PHENOMENA_URL=https://<user>.github.io/<repo>/data/phenomena.json
