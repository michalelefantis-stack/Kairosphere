# Copy to .env.local (frontend) or .env (pipeline). Both are gitignored.
#
# Anything named VITE_* is compiled into the browser bundle and is public by
# definition. Never put a secret in a VITE_ variable.

# ── Frontend ────────────────────────────────────────────────────────────────

# Where the AI backend lives.
#   Web dev:  leave blank — vite proxies /api to http://localhost:8787
#   Mobile:   REQUIRED. The packaged app has no proxy, and a blank value makes
#             it request https://localhost/api/... (its own bundled assets)
#             and 404. Point it at your deployed server.
# VITE_API_BASE_URL=https://api.kairosphere.app

# Where the live phenomena feed is published.
#   Web dev:  leave blank — the bundled public/data/phenomena.json is used
#   Mobile:   STRONGLY RECOMMENDED. Without it the app ships a feed frozen at
#             build time that only decays. With it the app refreshes over the
#             network and keeps the bundled copy as an offline fallback.
# VITE_PHENOMENA_URL=https://<user>.github.io/<repo>/data/phenomena.json

# Where the per-country local-news feeds are published. Defaults to the
# bundled data/local directory.
# VITE_LOCAL_FEED_URL=https://<user>.github.io/<repo>/data/local

# ── Pipeline (not shipped to the browser) ───────────────────────────────────

# Classifies news headlines into events and separates public ceremony from
# private grief. Without it the monitor marks every feed "unfiltered" and the
# app refuses to display it. Put the same value in the GEMINI_API_KEY GitHub
# secret so the scheduled workflow can use it.
GEMINI_API_KEY=
